resume/
resumes/
drafts/
uploads/
*.docx
*.pdf
!docs/*.pdf
!LICENSE

# 任何含个人信息的表格
*.xlsx
*.csv

# 照片 / 证件照
photos/
avatar*
!docs/images/*.png

